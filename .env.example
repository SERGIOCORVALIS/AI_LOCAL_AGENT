# =============================================================================
# Local AI Agent — environment template
# Copy to .env and fill secrets. Never commit a real .env.
# Prefix for all keys: LOCAL_AI_AGENT_
# =============================================================================

LOCAL_AI_AGENT_ENV=prod                       #env: prod/dev
LOCAL_AI_AGENT_LOG_LEVEL=INFO                 #log level: INFO/DEBUG/ERROR/WARNING/CRITICAL
LOCAL_AI_AGENT_APP_NAME=local-ai-agent        #app name: local-ai-agent

# --- Ollama model slots (short family ids resolve to installed tags) ---
LOCAL_AI_AGENT_MODEL_PRIMARY=gemma4          #primary model: gemma4:31B
LOCAL_AI_AGENT_MODEL_ROUTER=gemma4           #router model: gemma4:e4b 
LOCAL_AI_AGENT_MODEL_VISION=gemma4           #vision model: gemma4:e2b
LOCAL_AI_AGENT_MODEL_EMBED=nomic-embed-text  #embed model: nomic-embed-text
# Optional pinned tags:
# LOCAL_AI_AGENT_MODEL_PRIMARY=gemma4:e4b-it-q4_K_M       

# Omit for native Ollama embedding size; set e.g. 768 to force projection.
# LOCAL_AI_AGENT_EMBEDDING_DIMENSIONS=768
LOCAL_AI_AGENT_EMBEDDING_PREFER_NATIVE=true       #true: use native, false: use projection

# Host URLs (Docker Compose overrides Qdrant/Ollama inside the api container)   
LOCAL_AI_AGENT_OLLAMA_URL=http://127.0.0.1:11434           #url: http://127.0.0.1:11434/v1/responses
LOCAL_AI_AGENT_QDRANT_URL=http://127.0.0.1:6333            #url: http://127.0.0.1:6333/collections/agent_memory/points
LOCAL_AI_AGENT_QDRANT_COLLECTION=agent_memory              #collection name: agent_memory

# --- Runtime paths ---
LOCAL_AI_AGENT_RUNTIME_LOG_PATH=./runtime/logs/agent.log     
LOCAL_AI_AGENT_AUDIT_LOG_PATH=./runtime/audit/events.jsonl   
LOCAL_AI_AGENT_TASK_STORE_PATH=./runtime/tasks/state.json
LOCAL_AI_AGENT_MEMORY_STORE_PATH=./runtime/memory/preferences.json
LOCAL_AI_AGENT_BACKUP_DIR=./backups
LOCAL_AI_AGENT_DOWNLOADS_WATCH_PATH=C:/Users/your-user/Downloads 
LOCAL_AI_AGENT_ADMIN_UI_TITLE=Local AI Agent Admin

# --- Sandbox / coding agents ---b 
LOCAL_AI_AGENT_SANDBOX_PREFER_DOCKER=true         #true: use docker, false: use local
LOCAL_AI_AGENT_CODING_AGENTS_ENABLED=true         #true: enable, false: disable
LOCAL_AI_AGENT_CODING_AGENT_DEFAULT=auto          #auto|codex|opencode|droid|claude    
LOCAL_AI_AGENT_CODING_AGENT_TIMEOUT_SECONDS=300   #timeout: 300 seconds = 5 minutes
# LOCAL_AI_AGENT_CODING_AGENT_MODEL=gemma4        #model: gemma4/ollama/qwin/...
# Compose sets this to http://coding:8091 for the API container.
# On the host (CLI doctor against a running stack): http://127.0.0.1:8091
# Leave empty for local PATH discovery (host Python without Docker sidecar).
LOCAL_AI_AGENT_CODING_AGENTS_URL=                  #url: http://127.0.0.1:8091

# STT: empty/auto = Russian+English autodetection
# LOCAL_AI_AGENT_STT_LANGUAGE=ru

# --- API security ---
LOCAL_AI_AGENT_API_BIND_HOST=127.0.0.1                      #host: 127.0.0.1
LOCAL_AI_AGENT_TRUSTED_HOSTS=127.0.0.1,localhost            #trusted hosts: 127.0.0.1,localhost
# Required when ENV=prod and REQUIRE_API_TOKEN=true
LOCAL_AI_AGENT_API_TOKEN=change-me-to-a-long-random-token   #token: change-me-to-a-long-random-token
LOCAL_AI_AGENT_REQUIRE_API_TOKEN=true                       #true: require, false: not require

# --- Policy ---
LOCAL_AI_AGENT_ALLOWED_EXECUTE_ACTIONS_RAW=bootstrap,noop,reflect,sandbox_run,web_fetch,web_search,write_file,coding_agent,code_intel,fs_scan,fs_watch,vision_inspect,browser_open      #allowed actions: bootstrap,noop,reflect,sandbox_run,web_fetch,web_search,write_file,coding_agent,code_intel,fs_scan,fs_watch,vision_inspect,browser_open
LOCAL_AI_AGENT_DENIED_EXECUTE_ACTIONS_RAW=format_disk,wipe_system,exfiltrate_secrets       #denied actions: format_disk,wipe_system,exfiltrate_secrets

# --- Telegram (admin-chat only) ---
# 1) Create bot with @BotFather → paste token BELOW (no spaces, no # comments on the same line)
# 2) Write /start to the bot, then put YOUR numeric chat id below
#    (get id via @userinfobot or from API status / logs after first message)
# 3) Restart agent: restart-agent.cmd or REBUT-DOKER.cmd
# Polling starts only when BOTH values are set and non-placeholder.
LOCAL_AI_AGENT_TELEGRAM_BOT_TOKEN=       #bot token: 
LOCAL_AI_AGENT_TELEGRAM_ADMIN_CHAT_ID=   #admin chat id: 

# Tip: do not append inline comments after secrets, e.g. avoid:
# LOCAL_AI_AGENT_TELEGRAM_BOT_TOKEN=123:ABC # my bot
# Prefer a separate comment line above the key.
